OPENAI_API_KEY=
# Required. Bounds the in-memory /messages ingestion queue; no built-in default.
# Past this many queued-but-unprocessed episodes, /messages returns 503 with
# Retry-After instead of growing the queue further. Each queued item holds one
# message's content plus a small wrapper; size this from your pod's memory
# budget for the queue divided by your expected message size.
INGEST_QUEUE_MAXSIZE=
# Required for ordinary reads that target the OPR-owned graph group.
OPR_READ_TOKEN=
# Required for ordinary writes that target the OPR-owned graph group.
OPR_WRITE_TOKEN=
# Required only for the privileged retired-episode reconciliation listing.
OPR_RECONCILIATION_TOKEN=
# Required only for conditional episode retirement; must be distinct from the listing token.
OPR_RETIREMENT_TOKEN=
# Fresh >=32-byte controller nonce; reset stays off until all writers are compatible and drained.
OPR_WRITER_FLEET_EPOCH=
# Required for legacy destructive endpoints outside the OPR retirement workflow.
GRAPHITI_ADMIN_TOKEN=
# Global clear remains disabled even with the admin token unless explicitly enabled.
GRAPHITI_ADMIN_CLEAR_ENABLED=false
NEO4J_PORT=7687
# Only used if not running a neo4j container in docker
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
