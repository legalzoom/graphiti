# syntax=docker/dockerfile:1
# Standalone Graphiti MCP Server Image
# This image runs only the MCP server and connects to an external database (Neo4j, FalkorDB, or Neptune)
#
# BUILD CONTEXT IS THE REPOSITORY ROOT, not mcp_server/.
# The root is required because USE_LOCAL_CORE needs graphiti_core/, which lives
# outside mcp_server/ and cannot be reached from a narrower context. Every COPY
# below is therefore written relative to the repo root. Build with:
#   docker build -f mcp_server/docker/Dockerfile.standalone .

FROM python:3.11-slim-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv for Python package management
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh

# Add uv to PATH
ENV PATH="/root/.local/bin:${PATH}"

# Install Socket Firewall (sfw) for dependency fetches when SOCKET_API_KEY is
# provided as a BuildKit secret. Community builds without the secret fall back
# to direct installs.
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) SFW_ARCH=x86_64 ;; \
      arm64) SFW_ARCH=arm64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 --proto '=https' --tlsv1.2 \
      "https://github.com/SocketDev/firewall-release/releases/latest/download/sfw-linux-${SFW_ARCH}" \
      -o /usr/local/bin/sfw; \
    chmod +x /usr/local/bin/sfw

# Configure uv for optimal Docker usage
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    MCP_SERVER_HOST="0.0.0.0" \
    PYTHONUNBUFFERED=1

# Set up MCP server directory
WORKDIR /app/mcp

# Accept graphiti-core version as build argument. Only consulted when
# USE_LOCAL_CORE=false, since a local install takes its version from the source.
ARG GRAPHITI_CORE_VERSION=0.29.4
ARG SOCKET_FIREWALL_ENABLED=false
# Unique per release run so enforced builds re-resolve and re-download instead
# of reusing cached layers, which sfw would never see.
ARG SOCKET_SCAN_ID=

# USE_LOCAL_CORE mirrors the root Dockerfile. A downstream fork that patches
# graphiti_core/ must set this true, or the image resolves graphiti-core from
# PyPI and ships upstream's library underneath the fork's MCP server. A fork
# whose pyproject version has moved past the newest published release cannot
# use the PyPI path at all, because the pinned version resolves to nothing.
ARG USE_LOCAL_CORE=false

# Copy project files for dependency installation
COPY mcp_server/pyproject.toml mcp_server/uv.lock ./

# The graphiti-core package itself, landing at /app so that the existing
# [tool.uv.sources] entry in mcp_server/pyproject.toml
#   graphiti-core = { path = "..", editable = true }
# resolves to it from WORKDIR /app/mcp. No rewriting of that entry is needed.
# Copied unconditionally because COPY cannot be conditional; when
# USE_LOCAL_CORE=false the sources entry is stripped below and these are unused.
COPY pyproject.toml README.md /app/
COPY graphiti_core /app/graphiti_core

# Remove the local path override for graphiti-core in Docker builds
# Install with all supported database extras for maximum flexibility
# and regenerate lock file to match the PyPI version.
# When socket_api_key is mounted (official releases), route through sfw.
RUN --mount=type=secret,id=socket_api_key \
    set -eu; \
    export SFW_TELEMETRY_DISABLED=true; \
    export SFW_CUSTOM_REGISTRIES="wrap:storage.googleapis.com,wrap:classic.yarnpkg.com,wrap:files.pythonhosted.org"; \
    if [ "$SOCKET_FIREWALL_ENABLED" = "true" ]; then \
      if [ ! -s /run/secrets/socket_api_key ]; then \
        echo "ERROR: SOCKET_FIREWALL_ENABLED=true but socket_api_key is missing" >&2; \
        exit 1; \
      fi; \
      export SOCKET_API_KEY="$(cat /run/secrets/socket_api_key)"; \
      export UV_NO_CACHE=1; \
      echo "Socket Firewall enforced (scan id: ${SOCKET_SCAN_ID})"; \
      UV_CMD="sfw uv"; \
    else \
      echo "socket_api_key absent; installing without Socket Firewall"; \
      UV_CMD="uv"; \
    fi; \
    if [ "$USE_LOCAL_CORE" = "true" ]; then \
      echo "Resolving graphiti-core from local source at /app"; \
      sed -i 's/graphiti-core\[falkordb\]/graphiti-core[falkordb,neptune]/' pyproject.toml; \
    else \
      sed -i '/\[tool\.uv\.sources\]/,/graphiti-core/d' pyproject.toml; \
      sed -i "s/graphiti-core\[falkordb\][>=]\+[0-9]\+\.[0-9]\+\.[0-9]\+/graphiti-core[neo4j,falkordb,neptune]==${GRAPHITI_CORE_VERSION}/" pyproject.toml; \
      echo "Regenerating lock file for PyPI graphiti-core..."; \
    fi; \
    rm -f uv.lock; \
    $UV_CMD lock

# Install Python dependencies (exclude dev dependency group)
# Include optional provider extras so the image matches the providers
# advertised by the MCP server configuration and docs.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=secret,id=socket_api_key \
    set -eu; \
    export SFW_TELEMETRY_DISABLED=true; \
    export SFW_CUSTOM_REGISTRIES="wrap:storage.googleapis.com,wrap:classic.yarnpkg.com,wrap:files.pythonhosted.org"; \
    if [ "$SOCKET_FIREWALL_ENABLED" = "true" ]; then \
      if [ ! -s /run/secrets/socket_api_key ]; then \
        echo "ERROR: SOCKET_FIREWALL_ENABLED=true but socket_api_key is missing" >&2; \
        exit 1; \
      fi; \
      export SOCKET_API_KEY="$(cat /run/secrets/socket_api_key)"; \
      export UV_NO_CACHE=1; \
      echo "Socket Firewall enforced (scan id: ${SOCKET_SCAN_ID})"; \
      UV_CMD="sfw uv"; \
    else \
      echo "socket_api_key absent; installing without Socket Firewall"; \
      UV_CMD="uv"; \
    fi; \
    $UV_CMD sync --no-group dev --extra providers --extra azure

# Store graphiti-core version. On a local install GRAPHITI_CORE_VERSION was
# never consulted, so record what was actually installed rather than an
# argument that had no effect.
RUN set -eu; \
    if [ "$USE_LOCAL_CORE" = "true" ]; then \
      awk -F'"' '/^version = /{print $2; exit}' /app/pyproject.toml > /app/mcp/.graphiti-core-version; \
    else \
      echo "${GRAPHITI_CORE_VERSION}" > /app/mcp/.graphiti-core-version; \
    fi

# Copy MCP server application code
COPY mcp_server/main.py ./
COPY mcp_server/src/ ./src/
COPY mcp_server/config/ ./config/

# Create log directory
RUN mkdir -p /var/log/graphiti

# Add Docker labels with version information
ARG MCP_SERVER_VERSION=1.0.3
ARG BUILD_DATE
ARG VCS_REF
LABEL org.opencontainers.image.title="Graphiti MCP Server (Standalone)" \
      org.opencontainers.image.description="Standalone Graphiti MCP server for external Neo4j, FalkorDB, or Neptune" \
      org.opencontainers.image.version="${MCP_SERVER_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="Zep AI" \
      org.opencontainers.image.source="https://github.com/zep-ai/graphiti" \
      graphiti.core.version="${GRAPHITI_CORE_VERSION}"

# Expose MCP server port
EXPOSE 8000

# Health check - verify MCP server is responding
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the MCP server
CMD ["uv", "run", "--no-sync", "main.py"]
